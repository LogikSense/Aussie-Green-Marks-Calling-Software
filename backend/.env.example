# Backend Environment Variables
# Copy to .env for local; set in dashboard (e.g. Render) for production.

# API Keys (comma-separated). Generate: openssl rand -hex 32
API_KEYS=

# Database: PostgreSQL (local/prod). For local SQLite omit or use sqlite:///./app.db
DATABASE_URL=postgresql://voisai:123456@localhost:5432/crm_outcalling_db

# Auth (required for login/register). Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# Server
PORT=8000
PYTHON_VERSION=3.11.0

# HTTPS (optional)
USE_HTTPS=false
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem

# Twilio Voice SDK (softphone token). Required for /api/twilio/token.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
# Twilio REST API (number search/purchase, transfers).
TWILIO_AUTH_TOKEN=

# Telnyx v2 API key from Mission Control → API Keys. Must start with KEY_
TELNYX_API_KEY=

# Credits charged per outbound AI call (wallet).
CALL_CREDIT_COST=0.50
